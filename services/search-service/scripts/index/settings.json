{
  "settings": {
    "index": {
      "number_of_shards": 3,
      "number_of_replicas": 1,
      "refresh_interval": "1s"
    },
    "analysis": {
      "filter": {
        "english_stop":   { "type": "stop", "stopwords": "_english_" },
        "english_stemmer":{ "type": "stemmer", "language": "light_english" },
        "arabic_stop":    { "type": "stop", "stopwords": "_arabic_" },
        "arabic_stemmer": { "type": "stemmer", "language": "arabic" },
        "ngram_edge":     { "type": "edge_ngram", "min_gram": 2, "max_gram": 15 }
      },
      "analyzer": {
        "taqeem_text": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding",
            "arabic_normalization",
            "english_stop",
            "arabic_stop",
            "english_stemmer",
            "arabic_stemmer"
          ]
        },
        "taqeem_autocomplete": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "ngram_edge"]
        },
        "taqeem_search_autocomplete": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      }
    }
  }
}
