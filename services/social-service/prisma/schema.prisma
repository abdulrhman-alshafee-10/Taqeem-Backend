generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CollectionType {
  USER_LIST // private or shared user list
  EDITORIAL // curated by staff, always public
  LOCAL_GUIDE // curated by a Local Guide, public
  AUTO // system-generated
}

enum CollectionVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model Collection {
  id            String               @id @default(uuid()) @db.Uuid
  ownerId       String               @map("owner_id") @db.Uuid
  type          CollectionType       @default(USER_LIST)
  visibility    CollectionVisibility @default(PRIVATE)
  title         String
  slug          String               @unique
  description   String?
  coverImageUrl String?              @map("cover_image_url")
  city          String?
  categories    String[]             @default([])
  tags          String[]             @default([])
  isFeatured    Boolean              @default(false) @map("is_featured")
  systemKey     String?              @map("system_key")

  items         CollectionItem[]
  followers     CollectionFollower[]
  collaborators CollectionCollaborator[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([ownerId, systemKey])
  @@index([type, visibility, city])
  @@index([ownerId])
}

model CollectionItem {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  note         String?
  position     Int      @default(0)
  addedById    String   @map("added_by_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, businessId])
  @@index([collectionId, position])
}

model CollectionCollaborator {
  collectionId String   @map("collection_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  role         String   @default("EDITOR") // EDITOR | VIEWER
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([collectionId, userId])
}

model CollectionFollower {
  collectionId String   @map("collection_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  followedAt   DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([collectionId, userId])
}

enum FollowTarget {
  USER
  BUSINESS
  LIST
}

model Follow {
  id         String       @id @default(uuid()) @db.Uuid
  followerId String       @map("follower_id") @db.Uuid
  target     FollowTarget
  targetId   String       @map("target_id") @db.Uuid
  createdAt  DateTime     @default(now())

  @@unique([followerId, target, targetId])
  @@index([target, targetId])
}

model Recommendation {
  id         String    @id @default(uuid()) @db.Uuid
  fromUserId String    @map("from_user_id") @db.Uuid
  toUserId   String    @map("to_user_id") @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  note       String?   @db.VarChar(280)
  createdAt  DateTime  @default(now())
  seenAt     DateTime? @map("seen_at")

  @@unique([fromUserId, toUserId, businessId])
  @@index([toUserId, createdAt])
  @@index([fromUserId, businessId])
}

model LocalGuide {
  userId          String    @id @db.Uuid // soft FK to User.id
  city            String
  status          String    @default("APPLIED") // APPLIED | APPROVED | REVOKED
  applicationText String?
  approvedById    String?   @map("approved_by_id") @db.Uuid
  approvedAt      DateTime?
  perks           String[]  @default([]) // ["priority_support","early_features", "editorial_publish", "verified_badge"]

  @@index([city, status])
}

model Meetup {
  id              String    @id @default(uuid()) @db.Uuid
  organizerId     String    @map("organizer_id") @db.Uuid
  businessId      String    @map("business_id") @db.Uuid // hosted at
  title           String
  description     String?
  startsAt        DateTime
  endsAt          DateTime?
  capacity        Int?
  isPublic        Boolean   @default(true)
  status          String    @default("SCHEDULED") // SCHEDULED | CANCELLED | ENDED
  createdAt       DateTime  @default(now())
  tags            String[]  @default([])
  coverImageUrl   String?
  reservationId   String?   @map("reservation_id") @db.Uuid // linked auto-reservation
  requireApproval Boolean   @default(false)

  rsvps MeetupRsvp[]

  @@index([startsAt])
  @@index([businessId])
}

model MeetupRsvp {
  meetupId  String   @map("meetup_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @default("GOING") // GOING | MAYBE | DECLINED
  createdAt DateTime @default(now())

  meetup Meetup @relation(fields: [meetupId], references: [id], onDelete: Cascade)

  @@id([meetupId, userId])
}

model WantAlert {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  windowMin  Int      @default(120)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  routingKey  String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)

  @@index([publishedAt, createdAt])
}
