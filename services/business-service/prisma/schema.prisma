generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClaimStatus {
  UNCLAIMED
  PENDING
  APPROVED
  REJECTED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum BusinessStatus {
  OPEN
  TEMPORARILY_CLOSED
  PERMANENTLY_CLOSED
}



enum PriceTier {
  ONE     // $
  TWO     // $$
  THREE   // $$$
  FOUR    // $$$$
}

model Business {
  id            String       @id @default(uuid()) @db.Uuid
  ownerId       String?      @map("owner_id") @db.Uuid   // soft FK to User.id
  name          String
  slug          String       @unique
  description   String?
  categories    String[]     @default([])
  priceTier     PriceTier?   @map("price_tier")
  phone         String?
  website       String?
  email         String?
  photos        String[]     @default([])
  features         String[] @default([])                @map("features")
  dietary          String[] @default([])                @map("dietary")
  atmosphere       String[] @default([])                @map("atmosphere")
  paymentMethods   String[] @default([])                @map("payment_methods")

  // Location
  addressLine1  String       @map("address_line_1")
  addressLine2  String?      @map("address_line_2")
  city          String
  region        String
  country       String
  postalCode    String       @map("postal_code")
  latitude      Float
  longitude     Float

  // Denormalized aggregates (updated by event consumer)
  avgRating     Float        @default(0)  @map("avg_rating")
  reviewCount   Int          @default(0)  @map("review_count")
  aspectAvgFood        Float  @default(0) @map("aspect_avg_food")
  aspectAvgService     Float  @default(0) @map("aspect_avg_service")
  aspectAvgAmbience    Float  @default(0) @map("aspect_avg_ambience")
  aspectAvgValue       Float  @default(0) @map("aspect_avg_value")
  aspectAvgCleanliness Float  @default(0) @map("aspect_avg_cleanliness")
  aspectCountFood      Int    @default(0) @map("aspect_count_food")
  aspectCountService   Int    @default(0) @map("aspect_count_service")
  aspectCountAmbience  Int    @default(0) @map("aspect_count_ambience")
  aspectCountValue     Int    @default(0) @map("aspect_count_value")
  aspectCountCleanliness Int  @default(0) @map("aspect_count_cleanliness")

  // Claim
  claimStatus   ClaimStatus  @default(UNCLAIMED) @map("claim_status")

  hours         BusinessHours[]
  claims        BusinessClaim[]
  members       BusinessMember[]
  summary       BusinessSummary?
  summaryHistory BusinessSummaryHistory[]

  groupId       String?        @map("group_id") @db.Uuid
  group         BusinessGroup? @relation(fields: [groupId], references: [id])

  isReservationsEnabled Boolean @default(false) @map("is_reservations_enabled")
  isActive      Boolean      @default(true) @map("is_active")
  businessStatus BusinessStatus @default(OPEN) @map("business_status")
  closedAt       DateTime? @map("closed_at")
  mergedIntoId   String?   @map("merged_into_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt      @map("updated_at")

  @@index([ownerId])
  @@index([groupId])
  @@index([city, region, country])
  @@index([categories], type: Gin)
  @@index([features],       type: Gin)
  @@index([dietary],        type: Gin)
  @@index([atmosphere],     type: Gin)
  @@index([paymentMethods], type: Gin)
  @@map("businesses")
}

model BusinessHours {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  // 0 = Sunday ... 6 = Saturday
  dayOfWeek   Int      @map("day_of_week")
  openTime    String   @map("open_time")   // "09:00"
  closeTime   String   @map("close_time")  // "22:00"
  isClosed    Boolean  @default(false) @map("is_closed")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("business_hours")
}

model BusinessClaim {
  id            String       @id @default(uuid()) @db.Uuid
  businessId    String       @map("business_id") @db.Uuid
  claimantId    String       @map("claimant_id") @db.Uuid  // soft FK to User.id
  proofUrl      String?      @map("proof_url")
  status        ClaimStatus  @default(PENDING)
  reviewerNote  String?      @map("reviewer_note")
  createdAt     DateTime     @default(now()) @map("created_at")
  resolvedAt    DateTime?    @map("resolved_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([claimantId])
  @@index([status])
  @@map("business_claims")
}

model Menu {
  id         String       @id @default(uuid()) @db.Uuid
  businessId String       @map("business_id") @db.Uuid
  name       String       // e.g. "Main menu", "Ramadan menu"
  currency   String       @default("EGP")
  isActive   Boolean      @default(true) @map("is_active")
  validFrom  DateTime?    @map("valid_from")
  validTo    DateTime?    @map("valid_to")
  sections   MenuSection[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([businessId, isActive])
}

model MenuSection {
  id       String      @id @default(uuid()) @db.Uuid
  menuId   String      @map("menu_id") @db.Uuid
  title    String
  position Int         @default(0)
  items    MenuItem[]

  menu Menu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId, position])
}

model MenuItem {
  id            String        @id @default(uuid()) @db.Uuid
  sectionId     String        @map("section_id") @db.Uuid
  name          String
  description   String?
  basePrice     Decimal       @db.Decimal(10,2) @map("base_price")
  photoUrl      String?       @map("photo_url")
  isAvailable   Boolean       @default(true)
  dietary       String[]      @default([])   // vegan, vegetarian, halal, gluten_free
  spiciness     Int?          @db.SmallInt   // 0..3
  caloriesKcal  Int?          @map("calories_kcal")
  tags          String[]      @default([])   // popular, chef_special, new
  position      Int           @default(0)
  variants      MenuVariant[]

  section MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, position])
}

model MenuVariant {
  id      String   @id @default(uuid()) @db.Uuid
  itemId  String   @map("item_id") @db.Uuid
  label   String              // "Small", "Large", "With extra shot"
  priceDelta Decimal @db.Decimal(10,2) @default(0)

  item MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

enum OwnerPostType {
  OFFER
  ANNOUNCEMENT
  EVENT
  MENU_UPDATE
}

model OwnerPost {
  id          String        @id @default(uuid()) @db.Uuid
  businessId  String        @map("business_id") @db.Uuid
  authorId    String        @map("author_id") @db.Uuid   // owner userId
  type        OwnerPostType
  title       String
  body        String?
  photoUrl    String?
  validFrom   DateTime      @default(now()) @map("valid_from")
  validTo     DateTime?     @map("valid_to")
  couponCode  String?       @map("coupon_code")
  ctaUrl      String?
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([businessId, isPublished, validFrom])
}

model BusinessQuestion {
  id           String  @id @default(uuid()) @db.Uuid
  businessId   String  @map("business_id") @db.Uuid
  askerId      String  @map("asker_id") @db.Uuid
  body         String  @db.VarChar(500)
  isHidden     Boolean @default(false)
  helpfulCount Int     @default(0)
  createdAt    DateTime @default(now())

  answers      BusinessAnswer[]

  @@index([businessId, createdAt])
}

model BusinessAnswer {
  id          String  @id @default(uuid()) @db.Uuid
  questionId  String  @map("question_id") @db.Uuid
  authorId    String  @map("author_id") @db.Uuid
  isOwner     Boolean @default(false)
  body        String  @db.VarChar(1000)
  helpfulCount Int    @default(0)
  createdAt   DateTime @default(now())

  question BusinessQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, createdAt])
}

model BusinessGroup {
  id         String     @id @default(uuid()) @db.Uuid
  ownerId    String     @map("owner_id") @db.Uuid
  name       String
  slug       String     @unique
  logoUrl    String?
  websiteUrl String?
  createdAt  DateTime   @default(now())
  businesses Business[]

  @@index([ownerId])
}

enum BusinessMemberRole {
  OWNER
  MANAGER
  STAFF
}

model BusinessMember {
  businessId String              @map("business_id") @db.Uuid
  userId     String              @map("user_id") @db.Uuid
  role       BusinessMemberRole
  invitedById String?            @map("invited_by_id") @db.Uuid
  addedAt    DateTime            @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([businessId, userId])
  @@index([userId])
}

model WeeklyInsight {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  weekStart  DateTime @map("week_start")
  data       Json
  createdAt  DateTime @default(now())

  @@unique([businessId, weekStart])
}

model BusinessSummary {
  businessId  String   @id @db.Uuid
  data        Json
  reviewsUpTo DateTime @map("reviews_up_to")
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_summaries")
}

model BusinessSummaryHistory {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  data        Json
  reviewsUpTo DateTime @map("reviews_up_to")
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("business_summary_histories")
}

enum DealType {
  PERCENT_OFF
  FIXED_OFF
  BOGO
  FREE_ITEM
}

model Deal {
  id            String     @id @default(uuid()) @db.Uuid
  businessId    String     @map("business_id") @db.Uuid
  type          DealType
  title         String
  description   String?
  percentOff    Int?       @map("percent_off")
  fixedOff      Decimal?   @db.Decimal(10,2) @map("fixed_off")
  freeItemId    String?    @db.Uuid @map("free_item_id")
  minSubtotal   Decimal?   @db.Decimal(10,2) @map("min_subtotal")
  validDays     Int[]      @default([]) @map("valid_days")   // 0..6 (Sun..Sat)
  validHoursFrom String?   @map("valid_hours_from")           // "17:00"
  validHoursTo   String?   @map("valid_hours_to")             // "21:00"
  validFrom     DateTime   @map("valid_from")
  validTo       DateTime?  @map("valid_to")
  usageLimit    Int?       @map("usage_limit")                 // total redemptions
  perUserLimit  Int?       @default(1) @map("per_user_limit")
  couponCode    String?    @unique @map("coupon_code")
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())

  @@index([businessId, isActive])
}

model DealRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  dealId     String   @map("deal_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  amount     Decimal  @db.Decimal(10,2)
  redeemedAt DateTime @default(now())

  @@unique([dealId, orderId])
  @@index([dealId, redeemedAt])
  @@index([userId, dealId])
}

