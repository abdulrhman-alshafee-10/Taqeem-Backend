{
  "exchanges": [
    { "name": "taqeem.events", "vhost": "/", "type": "topic", "durable": true },
    { "name": "taqeem.events.dlx", "vhost": "/", "type": "topic", "durable": true }
  ],
  "queues": [
    { "name": "search.events.queue",       "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.search.events.queue" } },
    { "name": "business.events.queue",     "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.business.events.queue" } },
    { "name": "analytics.events.queue",    "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.analytics.events.queue" } },
    { "name": "moderation.events.queue",   "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.moderation.events.queue" } },
    { "name": "feed.events.queue",         "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.feed.events.queue" } },
    { "name": "notification.events.queue", "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.notification.events.queue" } },
    { "name": "user.events.queue",         "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.user.events.queue" } },
    { "name": "reservation.events.queue",  "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.reservation.events.queue" } },
    { "name": "social.events.queue",       "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.social.events.queue" } },
    { "name": "content.events.queue",      "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.content.events.queue" } },
    { "name": "agent.events.queue",        "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.agent.events.queue" } },
    { "name": "payment.events.queue",      "vhost": "/", "durable": true, "arguments": { "x-dead-letter-exchange": "taqeem.events.dlx", "x-dead-letter-routing-key": "dlq.payment.events.queue" } },
    { "name": "dlq.events.queue",          "vhost": "/", "durable": true }
  ],
  "bindings": [
    { "source": "taqeem.events", "destination": "search.events.queue",       "routing_key": "review.#" },
    { "source": "taqeem.events", "destination": "search.events.queue",       "routing_key": "business.#" },
    { "source": "taqeem.events", "destination": "search.events.queue",       "routing_key": "checkin.#" },
    { "source": "taqeem.events", "destination": "search.events.queue",       "routing_key": "tip.#" },
    { "source": "taqeem.events", "destination": "business.events.queue",     "routing_key": "review.#" },
    { "source": "taqeem.events", "destination": "analytics.events.queue",    "routing_key": "#" },
    { "source": "taqeem.events", "destination": "moderation.events.queue",   "routing_key": "review.#" },
    { "source": "taqeem.events", "destination": "moderation.events.queue",   "routing_key": "content.#" },
    { "source": "taqeem.events", "destination": "moderation.events.queue",   "routing_key": "business.claim_submitted" },
    { "source": "taqeem.events", "destination": "feed.events.queue",         "routing_key": "review.#" },
    { "source": "taqeem.events", "destination": "feed.events.queue",         "routing_key": "follow.#" },
    { "source": "taqeem.events", "destination": "feed.events.queue",         "routing_key": "list.#" },
    { "source": "taqeem.events", "destination": "feed.events.queue",         "routing_key": "tip.#" },
    { "source": "taqeem.events", "destination": "feed.events.queue",         "routing_key": "checkin.#" },
    { "source": "taqeem.events", "destination": "feed.events.queue",         "routing_key": "owner.#" },
    { "source": "taqeem.events", "destination": "feed.events.queue",         "routing_key": "business.#" },
    { "source": "taqeem.events", "destination": "notification.events.queue", "routing_key": "user.registered" },
    { "source": "taqeem.events", "destination": "notification.events.queue", "routing_key": "reservation.#" },
    { "source": "taqeem.events", "destination": "notification.events.queue", "routing_key": "payment.#" },
    { "source": "taqeem.events", "destination": "notification.events.queue", "routing_key": "review.replied" },
    { "source": "taqeem.events", "destination": "notification.events.queue", "routing_key": "follow.#" },
    { "source": "taqeem.events", "destination": "notification.events.queue", "routing_key": "moderation.#" },
    { "source": "taqeem.events", "destination": "notification.events.queue", "routing_key": "business.claim_*" },
    { "source": "taqeem.events", "destination": "user.events.queue",         "routing_key": "payment.succeeded" },
    { "source": "taqeem.events", "destination": "user.events.queue",         "routing_key": "review.helpful_voted" },
    { "source": "taqeem.events", "destination": "reservation.events.queue",  "routing_key": "payment.#" },
    { "source": "taqeem.events", "destination": "social.events.queue",       "routing_key": "follow.#" },
    { "source": "taqeem.events", "destination": "content.events.queue",      "routing_key": "checkin.created" },
    { "source": "taqeem.events", "destination": "agent.events.queue",        "routing_key": "review.created" },
    { "source": "taqeem.events", "destination": "agent.events.queue",        "routing_key": "review.updated" },
    { "source": "taqeem.events", "destination": "agent.events.queue",        "routing_key": "business.updated" },
    { "source": "taqeem.events", "destination": "agent.events.queue",        "routing_key": "menu.updated" },
    { "source": "taqeem.events", "destination": "payment.events.queue",      "routing_key": "reservation.cancelled" },
    { "source": "taqeem.events.dlx", "destination": "dlq.events.queue",      "routing_key": "dlq.#" }
  ]
}
